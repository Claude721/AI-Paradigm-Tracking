# AI 技术范式雷达 — 配置模板
# 复制为 .env 后填写；不要把真实密钥提交到代码仓库。
# 模板中的默认值大多不必另建 GitHub Variable；六项模型字段必填、两个 Key 放 Secrets。
# 此模板用于本地；云端只有 weekly-radar.yml 显式映射的 Variables/Secrets 生效。
# 逐入口验收脚本 scripts/source_audit.py 故意忽略 .env；只使用显式进程环境。
# 云端手动 source_check_only=true 会逐项检查 Variables/已允许的只读 API，
# 不运行模型、SMTP、研究或生产状态恢复；说明见 docs/SOURCE_ACCEPTANCE.md。
# source_platform_checks 是默认关闭的手动 Workflow input（不是生产 Variable）；
# 显式勾选才允许已启用平台的一次最小鉴权检查，Tavily/X 可能消耗额度。

# 默认使用新版“技术范式”流水线；legacy 为旧版项目型 Deal Flow。
PIPELINE_MODE=paradigm

# 任意支持 Chat Completions 与结构化 JSON 的兼容 API。换模型时一起改名称、地址、Key。
# MAIN 与 SUB 各自三项模型字段放 GitHub Actions Variables，各自 Key 只放 Secrets。
# 不再读取全局 LLM_PROVIDER/MODEL/BASE_URL/API_KEY 或旧 DASHSCOPE_API_KEY。
# Provider 指 API 服务商标签；BASE_URL 是 SDK 接口根地址，不是 /chat/completions 完整路径。
SUB_AGENT_PROVIDER=dashscope
SUB_AGENT_MODEL=qwen3.8-flash
SUB_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SUB_AGENT_LLM_API_KEY=
# 可选 JSON 协议覆盖；通常留空，跟随提供方协议而不是模型名/地址白名单。
SUB_AGENT_REQUEST_OPTIONS=
MAIN_AGENT_PROVIDER=dashscope
MAIN_AGENT_MODEL=qwen3.8-max
MAIN_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MAIN_AGENT_LLM_API_KEY=
MAIN_AGENT_REQUEST_OPTIONS=
# 单次模型请求上限；业务层另有一次可审计重试。
LLM_REQUEST_TIMEOUT_SECONDS=180
# DashScope 协议的默认思考模式；角色 REQUEST_OPTIONS 可独立覆盖。
LLM_ENABLE_THINKING=false
# 单个真实能力冒烟的总时限；多入口能力最多有界 failover 5 次，不调用生产召回器。
SMOKE_CHECK_TIMEOUT_SECONDS=30

# 学术发现与增强
# OpenAlex 当前需要免费 API Key：https://openalex.org/settings/api
OPENALEX_API_KEY=
# Semantic Scholar 只有申请到 Key 后才显式启用；没有学术邮箱就保持 false。
SEMANTIC_SCHOLAR_ENABLED=false
SEMANTIC_SCHOLAR_API_KEY=
# venue id 每个会议/年份可能变化，运行前应核对 OpenReview。
# 生产只召回 forum 投稿，页级检查点绑定固定研究窗口；429 不丢失健康页。
OPENREVIEW_VENUES=ICLR.cc/2026/Conference,NeurIPS.cc/2026/Conference
# 官方研究博客 RSS/Atom，逗号分隔。只填已验证的官方 Feed URL。
RESEARCH_FEED_URLS=
# 内置高信号思想源：LessWrong/Alignment Forum 官方 RSS 与手工核验 KOL Feed。
# 均不需要 Secret；阈值只表示 LessWrong frontpage 的 karma 入选下限。
LESSWRONG_SOURCE_ENABLED=true
LESSWRONG_KARMA_THRESHOLD=30
ALIGNMENT_FORUM_SOURCE_ENABLED=true
KOL_SOURCE_ENABLED=true
# 自定义 Feed 没有内置身份核验，默认只能成为二次解读；正式目录请改 research_watchlist.py。
KOL_CUSTOM_FEED_URLS=
# X 官方 API 默认关闭；确认权限/费用后才显式 true 并配置 Token。
# 同时控制 KOL 原创、社区标题搜索、legacy Twitter 和 Smoke。
KOL_X_SOURCE_ENABLED=false
# 完整默认名单随代码版本维护在 research_watchlist.py；这里留空即使用默认名单。
# merge（默认）会把下列内容作为自定义追加；replace 才会整体替换内置名单。
RESEARCH_WATCHLIST_MODE=merge
# 无 RSS 的官方研究/Technical Report 索引。添加页面只提高召回，不自动背书。
PRIORITY_RESEARCH_PAGES=
# 可选额外熔断；V0 仍受 PARADIGM_OFFICIAL_DETAIL_LIMIT 的有界取材约束。
# 未尝试/失败详情保留审计，不阻断其他已核验路线。
PRIORITY_RESEARCH_LINK_SAFETY_LIMIT=0
PRIORITY_RESEARCH_CONCURRENCY=6
# NYU 等无标识书目：显式开启才消耗 OpenAlex 身份搜索请求；不是全局/月度额度。
# 每个生产进程默认最多 8 次，未解析书目不能作为证据，不阻断健康路线。
PRIORITY_BIBLIOGRAPHY_RESOLUTION_ENABLED=false
PRIORITY_BIBLIOGRAPHY_REQUEST_LIMIT=8
# 独立 source-interface-acceptance 验收无需改变这两个生产变量；显式授权后仅临时验 NYU 1-8 次身份请求。
# 只追加经过核验的公司研究组织或具名实验室；不要填整所大学或歧义裸词。
ESTABLISHED_RESEARCH_ORGANIZATIONS=
# 覆盖值得持续观察、但不能仅凭品牌直接放行的厂商与机器人公司。
MONITORED_RESEARCH_ORGANIZATIONS=
# 重点研究者按完整姓名填写；仍需公开主页/ORCID/OpenAlex 等身份交叉核验。
PRIORITY_RESEARCHERS=

# GitHub Search 用于实现/复现；内置官方组织的新仓库若有可审计原创机制，
# 可以生成 original_implementation 假说，但仍须通过 Rubric 与势能闸门。
GITHUB_TOKEN=

# Follow Builders 的 KOL/播客是二次传播；其中可核验官方技术博客仍可作为原点。
FOLLOW_BUILDERS_ENABLED=true
FOLLOW_BUILDERS_FEED_URL=https://raw.githubusercontent.com/zarazhangrui/follow-builders/main
# 可选：按工作原始标题搜索最近 X 帖子，并核验作者公开账号/简介。
# 作者本人发布只用于身份核验，不计作独立二次讨论。
TWITTER_BEARER_TOKEN=
# 留空使用 research_watchlist.py 中已核验 handle；配置 X API 后按账号精确追踪。
TWITTER_WATCH_ACCOUNTS=

# Tavily：一次 basic 组合查询发现社区页面和独立技术博客。
# 官方有免费额度，但需核对账户套餐/PAYG；代码不能保证账户不会收费。
# 这些结果没有平台全量覆盖和可靠互动指标，只作为待核验线索。
TAVILY_API_KEY=
TAVILY_SOCIAL_SEARCH_ENABLED=true
TAVILY_SOCIAL_SEARCH_DOMAINS=x.com,twitter.com,reddit.com,xiaohongshu.com
TAVILY_SOCIAL_MAX_RESULTS=12
# 留空表示不按域名限制；填写后只检索指定站点。
TAVILY_DISCOVERY_DOMAINS=
# 0=覆盖全部通过 Rubric 的深挖候选；非零值是显式 credit 熔断。
TAVILY_REQUEST_SAFETY_LIMIT=0
# 跨 run UTC 自然月保护；每进程先核验 /usage，未知用量阻断，不退款失败请求。
# 不能替代供应商控制台关闭 PAYG；0 是显式取消月度保护。
TAVILY_MONTHLY_CREDIT_LIMIT=1000
# 独立接口验收另要求现有账户/Key 额度和 PAYG 关闭；未知额度不搜索，不自动修改套餐。

# Reddit 官方 Data API：必须先获得 Reddit 批准；商业用途需另行获得许可。
# 获批前保持 false，即使误填 Client Secret 也不会发请求。
REDDIT_API_ACCESS_APPROVED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:ai-paradigm-radar:v1.0 (by /u/YOUR_REDDIT_USERNAME)

# 技术决策来自版本化 Rubric。通常无需配置路径；直接维护仓库中的
# rubrics/paradigm_rubric.json 即可修改问题、选项权重和阶段阈值。
PARADIGM_RUBRIC_PATH=
# 留空使用仓库内 taxonomy/frontier_landscape.json。
FRONTIER_LANDSCAPE_PATH=
# 0=不限制。以下参数只是用户主动启用的运行熔断，不参与 Top-K 或研究去留；
# V0 的本期研究量由下方 RESEARCH_*_LIMIT 独立界定；熔断不代表技术淘汰。
PARADIGM_DISCOVERY_SAFETY_LIMIT=0
PARADIGM_ANALYSIS_SAFETY_LIMIT=0
PARADIGM_DEEP_SAFETY_LIMIT=0
PARADIGM_REPORT_SAFETY_LIMIT=0
PARADIGM_REFRESH_SAFETY_LIMIT=0
PARADIGM_RESEARCH_ORIGIN_LIMIT=48
PARADIGM_RESEARCH_DEEP_LIMIT=8
PARADIGM_RESEARCH_REFRESH_LIMIT=4
PARADIGM_MIN_PRIMARY_SOURCES=2
PARADIGM_SOURCE_QUERY_LIMIT=100
PARADIGM_SOURCE_PAGE_LIMIT=2
PARADIGM_OFFICIAL_DETAIL_LIMIT=6
# 与领域关键词并行，用完整姓名查询重点研究者近期论文；只提高召回，不自动入选。
PARADIGM_PRIORITY_AUTHOR_SWEEP_ENABLED=true
PARADIGM_MIN_SUBSTANTIVE_DISCUSSIONS=2
PARADIGM_MIN_SECONDARY_ENGAGEMENT=50
# 已报告范式出现实质新证据时允许标记为“进展更新”；相同签名绝不重复。
PARADIGM_ALLOW_UPDATES=true
# 普通论文召回使用 SOURCING_LOOKBACK_DAYS；下列 14 天只用于
# Technical Report、重点研究者和官方研究入口的重叠回补。
PARADIGM_RECALL_OVERLAP_DAYS=14
# 冷启动也默认仅回补 14 天；
# 不会把 arXiv/OpenAlex/OpenReview 的宽领域查询一起扩大。
PARADIGM_BOOTSTRAP_LOOKBACK_DAYS=14
# 可选：精确回补/复查 arXiv ID，逗号分隔；常规运行保持为空。
# 该参数只保证材料进入召回，绝不提高 Rubric 得分或编辑复核资格。
PARADIGM_SEED_ARXIV_IDS=
# 保留的人物档案安全上限；完整作者名单始终留在一手证据中。
PARADIGM_RESEARCHER_PROFILE_LIMIT=6
# 真正执行背景/联系方式核验并进入报告的人物上限。默认按一作、明确
# 通讯/资深作者、重点研究者选择，不让普通共同作者阻断整条路线交付。
PARADIGM_KEY_RESEARCHER_LIMIT=3
# 云端单轮软时间预算。它只控制本轮处理进度，未处理项会进入可续跑 backlog；
# 不影响 Rubric 或研究去留。已核验路线可独立交付；没有合格路线且本期选定研究未完成时失败。
# 与 1200s 报告上限组合时推荐 3600；不以取消预算或清库制造完成。
PARADIGM_RUN_BUDGET_SECONDS=3600
# 发现完成后，为深挖保留的目标余量。三类工作按耗时轮转，原点单次
# 访问也保留后续深挖空间；不是先完成整段抽取再使用此余量。
PARADIGM_STAGE_RESERVE_SECONDS=1200
# 单个发现源的墙上时间上限；超时来源会标为覆盖不完整，不会伪装成零命中。
PARADIGM_DISCOVERY_SOURCE_TIMEOUT_SECONDS=600
# 研究完成并进入 outbox 后，研究总编辑单独允许的最大渲染时间。
PARADIGM_REPORT_TIMEOUT_SECONDS=1200
# 路线起草/开篇总编单次 LLM 请求上限；与整份报告上限分开。
PARADIGM_REPORT_REQUEST_TIMEOUT_SECONDS=360
# 路线草稿并发；每条通过后立即写入 outbox checkpoint。
PARADIGM_REPORT_ROUTE_CONCURRENCY=2
PARADIGM_REPORT_MAX_RENDER_ATTEMPTS=3
# 可取消/可检查点的执行粒度，不是数量门槛。
PARADIGM_ANALYSIS_BATCH_SIZE=6
# 普通论文的保守批量资格预筛；不确定项仍进入完整 Rubric，漏回项保留 pending。
PARADIGM_ORIGIN_PREFILTER_ENABLED=true
PARADIGM_ORIGIN_PREFILTER_BATCH_SIZE=24
# 单份 Technical Report 每次出队最多评估的机制数；总机制数不设上限，跨轮续跑。
PARADIGM_TECHNICAL_REPORT_MECHANISM_SLICE=2
PARADIGM_DEEP_BATCH_SIZE=1
# 独立路线的完整深挖并发（1—4）；每条分别保存结果，不共享成功标记。
PARADIGM_DEEP_CONCURRENCY=2
# 额外研究 run 会增加 API 费用，默认关闭，需仓库所有者明确开启。
# 只续跑已上传健康状态的同一固定窗口，纯预算延期才允许自动排队。
PARADIGM_AUTO_RESUME_ENABLED=false
PARADIGM_AUTO_RESUME_MAX_RUNS=4
PARADIGM_AUTO_RESUME_TOTAL_BUDGET_SECONDS=14400
# 已确认累计 tokens 达限后不再排下一轮；不是单次请求的硬费用上限。
PARADIGM_AUTO_RESUME_MAX_TOKENS=4000000

# 本地调度每周五 09:15（上海时区）；GitHub 的时间由 Workflow schedule 固定，不读这四项。
SOURCING_LOOKBACK_DAYS=7
SCHEDULE_DAY_OF_WEEK=fri
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=15
SCHEDULE_TIMEZONE=Asia/Shanghai

# SMTP 邮件推送；密码使用邮箱服务商生成的应用密码/授权码。
EMAIL_PUSH_ENABLED=false
# true：邮件未发出则本次任务失败，不写入“已交付”状态（云端任务推荐）
EMAIL_PUSH_REQUIRED=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false
# 报告 Markdown 的最大附件字节数；超限时保留 outbox 并明确失败。
EMAIL_MAX_ATTACHMENT_BYTES=10000000

# legacy 的 Product Hunt / WeChat / QuantFilter 等参数不属于 V0 配置；需要时参考 config.py。
LOG_LEVEL=INFO
