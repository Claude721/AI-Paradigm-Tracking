# AI 技术范式雷达 — 配置模板
# 复制为 .env 后填写；不要把真实密钥提交到代码仓库。

# 默认使用新版“技术范式”流水线；legacy 为旧版项目型 Deal Flow。
PIPELINE_MODE=paradigm

# LLM：范式抽取与人物轨迹均使用 Qwen 3.7 系列。
LLM_PROVIDER=dashscope
LLM_MODEL=qwen3.7-plus
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SUB_AGENT_PROVIDER=dashscope
SUB_AGENT_MODEL=qwen3.7-plus
SUB_AGENT_API_KEY=
MAIN_AGENT_PROVIDER=dashscope
MAIN_AGENT_MODEL=qwen3.7-plus
MAIN_AGENT_API_KEY=

# 学术发现与增强
# OpenAlex 当前需要免费 API Key：https://openalex.org/settings/api
OPENALEX_API_KEY=
# Semantic Scholar 可无 Key 低频调用；生产周任务建议申请 Key。
SEMANTIC_SCHOLAR_API_KEY=
# venue id 每个会议/年份可能变化，运行前应核对 OpenReview。
OPENREVIEW_VENUES=ICLR.cc/2026/Conference,NeurIPS.cc/2026/Conference
# 官方研究博客 RSS/Atom，逗号分隔。只填已验证的官方 Feed URL。
RESEARCH_FEED_URLS=

# GitHub 只用于搜索代码实现/复现，不再生成范式候选。
GITHUB_TOKEN=

# 范式门槛：声量不作为准入门槛。
PARADIGM_MIN_SCORE=65
PARADIGM_MIN_NOVELTY=6
PARADIGM_MIN_SCOPE=6
PARADIGM_MAX_DISCOVERY_ITEMS=100
PARADIGM_MAX_REPORT_ITEMS=12
# 已报告范式出现实质新证据时允许标记为“进展更新”；相同签名绝不重复。
PARADIGM_ALLOW_UPDATES=true

# 每周五 09:00（上海时区）扫描最近 7 天；月度回顾可改 30。
SOURCING_LOOKBACK_DAYS=7
SCHEDULE_DAY_OF_WEEK=fri
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0
SCHEDULE_TIMEZONE=Asia/Shanghai

# SMTP 邮件推送；密码使用邮箱服务商生成的应用密码/授权码。
EMAIL_PUSH_ENABLED=false
# true：邮件未发出则本次任务失败，不写入“已交付”状态（云端任务推荐）
EMAIL_PUSH_REQUIRED=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false

# 可选旧版信源配置（仅 PIPELINE_MODE=legacy 时使用）
PRODUCTHUNT_TOKEN=
TWITTER_BEARER_TOKEN=
TWITTER_WATCH_ACCOUNTS=
FOLLOW_BUILDERS_ENABLED=false
WECHAT_SOURCE_ENABLED=false

LOG_LEVEL=INFO
